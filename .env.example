# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (Atlas or local). Use a hosted cluster for
# deployed environments; 127.0.0.1 is only reachable from your own machine.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>

# Pinata JWT from https://app.pinata.cloud/developers/api-keys
# Required when IPFS_PROVIDER is "pinata" (the default).
PINATA_JWT=<pinata-jwt>

# Optional: dedicated gateway subdomain, e.g. https://mypinata.gateway.pinata.cloud
PINATA_GATEWAY=

# "pinata" (default) or "kubo".
IPFS_PROVIDER=pinata

# Only read when IPFS_PROVIDER is "kubo".
KUBO_API_URL=http://127.0.0.1:5001
KUBO_GATEWAY_URL=http://127.0.0.1:8080

# WalletConnect Cloud project id from https://cloud.walletconnect.com
# Optional: injected wallets (MetaMask, Rabby) work without it. When unset,
# RainbowKit falls back to its public demo id for the WalletConnect QR option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# DocumentVault contract addresses per chain. 31337 defaults to the
# deterministic local Hardhat deployment; 11155111 (Sepolia) stays unset
# until you deploy there (cd hardhat && npm run deploy:sepolia).
NEXT_PUBLIC_VAULT_ADDRESS_31337=
NEXT_PUBLIC_VAULT_ADDRESS_11155111=

# Optional: block number to start AccessGranted log scans from on the
# Dashboard. Defaults to 0; set the deployment block on public networks.
NEXT_PUBLIC_VAULT_START_BLOCK=

# Gateway used by the browser to open CIDs ("Open on IPFS" buttons).
# Defaults to the public Pinata gateway when unset.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
